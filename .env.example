# --- 금융상품 Agent (미래에셋 AI Festival) ---------------------------------
# CLOVA Studio 콘솔에서 발급한 API Key
# Console > AI Services > CLOVA Studio > 테스트 앱/서비스 앱
CLOVASTUDIO_API_KEY=nv-...

# 구 방식(APIGW) 키를 발급받은 경우에만 필요
# NCP_APIGW_API_KEY=...

# 사용할 모델을 고정하고 싶을 때 (미지정 시 HCX-007 → 005 → 003 → DASH 순 자동 선택)
# CLOVASTUDIO_MODEL=HCX-007

# 엔드포인트 호스트 재정의
# CLOVASTUDIO_HOST=https://clovastudio.stream.ntruss.com


# --- 뉴스 번역기 (비정형 데이터 계층) --------------------------------------
# GOOGLE_API_KEY=...

# (옵션) API 호출 로깅
# DEBUG=true
